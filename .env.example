PORT=3000

# development: sin credenciales reales, el pago funciona en modo prueba (sin cobro).
# production: exige PAYPAL_CLIENT_ID y PAYPAL_SECRET; si faltan, el servidor no arranca.
NODE_ENV=development

# Credenciales de la app de PayPal (developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "production" para cobrar de verdad; cualquier otro valor usa el sandbox
PAYPAL_ENV=sandbox

# Registro de órdenes pagadas. En la nube, apuntar a un volumen persistente (p. ej. /data/orders.json)
# ORDERS_FILE=./data/orders.json
